# Dependencies
node_modules/
.npm/
npm-debug.log*

# Frontend build output
dist/
dist-deploy/
.vite/

# Rust build output (can be ~1 GB locally)
service/target/

# Test artifacts
test-results/
playwright-report/
playwright/.cache/
blob-report/
coverage/

# Environment files and credentials — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*

# Logs
*.log
logs/

# Local datasets and generated indexes — the 1B pack is ~477 MB and stays
# outside Git. public/pi-2m.txt (the 2 MB parity fixture) IS committed.
# Only root-level local dataset dirs; keep src/data/ application source tracked.
/data/
/data-*/
pi-atlas-1b/
*.pack
*.mmap
*.bin
# Exceptions: both browser datasets MUST ship in the Pages artifact/CI checkout.
# 2M is ~1 MB; the verified 1B static tree is ~478 MiB (100 x 5 MB chunks, each
# under GitHub's 100 MB/file limit) and is the full dataset served in production.
!public/data/pi-2m/chunks/*.bin
!public/data/pi-1b/chunks/*.bin

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# TypeScript incremental build cache
*.tsbuildinfo

# Pre-deploy smoke reports (generated locally, never committed)
smoke-report/
